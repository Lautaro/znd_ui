}

/* Loop crossmix spans on the waveform: faint = longest possible span, stronger = the part every loop uses. */
.znd-xmix { background-color: rgba(123,176,211,0.40); }
.znd-xmix--min { background-color: rgba(123,176,211,0.50); }
