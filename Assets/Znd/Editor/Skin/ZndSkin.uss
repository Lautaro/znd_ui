/* Znd skin: every button, toggle, slider, text and box look used by the Znd windows.
   Reskin here. Each look is a class (.znd-RichButton, .znd-RichToggle, .znd-slider-default, ...), with its states:
   :hover, :active, and .znd-on for a latched toggle. Corner shapes are .znd-corners--all/left/right/top/bottom/square.
   Images referenced by url() sit next to this file. */

.znd-root {
    --znd-pal-bg: rgba(26,39,50,1);
    --znd-pal-bigbutton: rgba(104,86,65,1);
    --znd-pal-bigbutton-hover: rgba(173,128,89,1);
    --znd-pal-text: rgba(123,176,211,1);
    --znd-pal-highlight: rgba(152,84,20,1);
    --znd-pal-highlight2: rgba(181,141,31,1);
    --znd-pal-warning: rgba(107,50,48,1);
    --znd-pal-default-toggle: rgba(23,29,34,1);
    --znd-pal-window-bg: rgba(44,58,71,1);
    --znd-pal-eq: rgba(255,99,0,1);
}

.znd-root .znd-RichButton.unity-button, .znd-root .znd-RichButton {
    margin: 0; background-color: rgba(0,0,0,0);
    -unity-background-scale-mode: stretch-to-fill;
    padding-left: 10px; padding-right: 10px;
    padding-top: 0; padding-bottom: 0;
    -unity-text-align: middle-center;
    border-top-left-radius: 0px; border-top-right-radius: 6px; border-bottom-left-radius: 6px; border-bottom-right-radius: 0px;
}
.znd-root .znd-RichButton.unity-button, .znd-root .znd-RichButton {
    background-color: rgba(0,0,0,0);
    background-image: url("RichButton_Normal.png");
    color: rgba(123,176,211,1);
    -unity-font-style: normal;
    text-shadow: 0px 0px 0px rgba(0,0,0,0);
    border-width: 0;
}
.znd-root .znd-RichButton.unity-button:hover, .znd-root .znd-RichButton:hover {
    background-color: rgba(0,0,0,0);
    background-image: url("RichButton_Hover.png");
    color: rgba(123,176,211,1);
    -unity-font-style: normal;
    text-shadow: 0px 0px 0px rgba(0,0,0,0);
    border-width: 0;
}
.znd-root .znd-RichButton.unity-button:active, .znd-root .znd-RichButton:active {
    background-color: rgba(0,0,0,0);
    background-image: url("RichButton_Active.png");
    color: rgba(237,232,213,1);
    -unity-font-style: normal;
    text-shadow: 0px 0px 0px rgba(0,0,0,0);
    border-width: 0;
}
.znd-root .znd-RichButton.znd-on, .znd-root .znd-RichButton.znd-on:hover, .znd-root .znd-RichButton.znd-on:active {
    background-color: rgba(0,0,0,0);
    background-image: url("RichButton_ToggleOn.png");
    color: rgba(237,232,213,1);
    -unity-font-style: normal;
    text-shadow: 0px 0px 0px rgba(0,0,0,0);
    border-width: 0;
}
.znd-root .znd-RichButton.znd-corners--all {
    border-top-left-radius: 6px; border-top-right-radius: 6px; border-bottom-left-radius: 6px; border-bottom-right-radius: 6px;
}
.znd-root .znd-RichButton.znd-corners--left {
    border-top-left-radius: 6px; border-top-right-radius: 0px; border-bottom-left-radius: 6px; border-bottom-right-radius: 0px;
}
.znd-root .znd-RichButton.znd-corners--right {
    border-top-left-radius: 0px; border-top-right-radius: 6px; border-bottom-left-radius: 0px; border-bottom-right-radius: 6px;
}
.znd-root .znd-RichButton.znd-corners--top {
    border-top-left-radius: 6px; border-top-right-radius: 6px; border-bottom-left-radius: 0px; border-bottom-right-radius: 0px;
}
.znd-root .znd-RichButton.znd-corners--bottom {
    border-top-left-radius: 0px; border-top-right-radius: 0px; border-bottom-left-radius: 6px; border-bottom-right-radius: 6px;
}
.znd-root .znd-RichButton.znd-corners--square {
    border-top-left-radius: 0px; border-top-right-radius: 0px; border-bottom-left-radius: 0px; border-bottom-right-radius: 0px;
}

