.znd-root .znd-box-default {
    -unity-background-scale-mode: stretch-to-fill;
    background-color: rgba(0,0,0,0);
    background-image: url("box-default.png");
    -unity-slice-left: 16; -unity-slice-right: 16; -unity-slice-top: 16; -unity-slice-bottom: 16;
    border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px;
    border-color: rgba(255,255,255,0.106);
    border-top-left-radius: 0px; border-top-right-radius: 0px; border-bottom-right-radius: 0px; border-bottom-left-radius: 0px;
    padding: 7px 7px 7px 19px;
    margin: 0px 0px 0px 0px;
}
.znd-root .znd-box-alternative {
    -unity-background-scale-mode: stretch-to-fill;
    background-color: rgba(0,0,0,0);
    background-image: url("box-alternative.png");
    border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px;
    border-color: rgba(255,255,255,0.06);
    border-top-left-radius: 0px; border-top-right-radius: 0px; border-bottom-right-radius: 0px; border-bottom-left-radius: 0px;
    padding: 7px 5px 7px 5px;
    margin: 0px 0px 0px 0px;
}
.znd-root .znd-box-warning {
    -unity-background-scale-mode: stretch-to-fill;
    background-image: none;
    background-color: rgba(71,31,26,1);
    border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px;
    border-color: rgba(255,255,255,0.06);
    border-top-left-radius: 0px; border-top-right-radius: 0px; border-bottom-right-radius: 0px; border-bottom-left-radius: 0px;
    padding: 7px 5px 7px 5px;
    margin: 4px 4px 4px 4px;
}
.znd-root .znd-box-subtle {
    -unity-background-scale-mode: stretch-to-fill;
    background-image: none;
    background-color: rgba(38,38,43,1);
    border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px;
